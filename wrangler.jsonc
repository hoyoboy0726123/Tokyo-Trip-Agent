{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyo-trip-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "TripRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripRoom"] }],
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_BACKUP_MODEL": "gemini-3.1-flash-lite",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "DEFAULT_PROVIDER": "gemini"
  },
  "observability": { "enabled": true }
}
